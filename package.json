{
  "name": "dsh-find-in-sessions",
  "version": "0.2.6",
  "description": "Ctrl+F cross-session keyword search for DeepSeek Harness, backed by a local SQLite FTS5 index",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/store.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "search",
    "session"
  ],
  "author": {
    "name": "ChengGuanjin666",
    "email": "3285676576@qq.com",
    "url": "https://github.com/ChengGuanjin666"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChengGuanjin666/dsh-find-in-sessions.git"
  },
  "homepage": "https://github.com/ChengGuanjin666/dsh-find-in-sessions#readme",
  "bugs": {
    "url": "https://github.com/ChengGuanjin666/dsh-find-in-sessions/issues"
  },
  "license": "MIT"
}
